{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sage X3 conversation business state",
  "type": "object",
  "required": ["schema_version", "conversation_id", "folder", "authority", "objective", "operations", "events", "engine", "context_revision", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "conversation_id": {"type": ["string", "null"]},
    "folder": {"enum": ["TEST", "OB"]},
    "authority": {"const": "context_only_no_execution_permission"},
    "objective": {"type": "object"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "resource", "action", "folder", "status", "parameters", "changes", "unknown_fields", "sources", "blockers"],
        "properties": {
          "id": {"type": "string"},
          "resource": {"type": "string"},
          "action": {"enum": ["create", "modify", "activate", "deactivate"]},
          "folder": {"enum": ["TEST", "OB"]},
          "status": {"type": "string"},
          "parameters": {"type": "object"},
          "changes": {"type": "object"},
          "unknown_fields": {"type": "array"},
          "sources": {"type": "object"},
          "blockers": {"type": "array"},
          "unit_conversion_requests": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["coefficient", "source_unit", "target_unit", "status", "evidence"],
              "properties": {
                "coefficient": {"type": "string"},
                "source_unit": {"type": ["string", "null"]},
                "target_unit": {"type": ["string", "null"]},
                "status": {"enum": ["needs_equivalence", "declared_equivalence"]},
                "evidence": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "events": {"type": "array", "maxItems": 100},
    "engine": {"type": "object"},
    "pending_creation": {"type": ["object", "null"]},
    "pending_modification": {"type": "object"},
    "references": {"type": "object"},
    "context_revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
